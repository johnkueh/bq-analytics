# GCP project + dataset names
GCP_PROJECT_ID=my-gcp-project
BQ_EVENTS_DATASET=events
BQ_LOGS_DATASET=logs

# Vercel OIDC → GCP Workload Identity Federation
# (server runtime auth — no service-account JSON keys needed)
GCP_PROJECT_NUMBER=123456789012
GCP_SERVICE_ACCOUNT_EMAIL=vercel-bq@my-gcp-project.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Optional API key for CLI / external scripts to POST /api/track
ANALYTICS_API_KEY=optional-shared-key

# Local dev only — falls back to Application Default Credentials
# Run: gcloud auth application-default login
