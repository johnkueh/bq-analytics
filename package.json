{
  "name": "bq-analytics",
  "version": "0.8.6",
  "description": "Tiny analytics SDK that sends events directly to BigQuery. PostHog/Segment-shaped API, ~$0/month at indie scale, queryable with bq CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnkueh/bq-analytics.git"
  },
  "homepage": "https://github.com/johnkueh/bq-analytics",
  "bugs": {
    "url": "https://github.com/johnkueh/bq-analytics/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.rn.d.ts",
        "import": "./dist/index.rn.js"
      },
      "browser": {
        "types": "./dist/index.rn.d.ts",
        "import": "./dist/index.rn.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "./browser": {
      "types": "./dist/transports/browser.d.ts",
      "import": "./dist/transports/browser.js"
    },
    "./react-native": {
      "types": "./dist/transports/react-native.d.ts",
      "import": "./dist/transports/react-native.js"
    },
    "./next": {
      "types": "./dist/handlers/next.d.ts",
      "import": "./dist/handlers/next.js"
    },
    "./next/flags": {
      "types": "./dist/handlers/next-flags.d.ts",
      "import": "./dist/handlers/next-flags.js"
    },
    "./hono": {
      "types": "./dist/handlers/hono.d.ts",
      "import": "./dist/handlers/hono.js"
    },
    "./pino": {
      "types": "./dist/transports/pino.d.ts",
      "import": "./dist/transports/pino.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./edge-config": {
      "types": "./dist/flag-sources/edge-config.d.ts",
      "import": "./dist/flag-sources/edge-config.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./config/edge-config": {
      "types": "./dist/config/edge-config.d.ts",
      "import": "./dist/config/edge-config.js"
    },
    "./config/http": {
      "types": "./dist/config/http.d.ts",
      "import": "./dist/config/http.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "import": "./dist/release/index.js"
    },
    "./release/native": {
      "types": "./dist/release/native/index.d.ts",
      "import": "./dist/release/native/index.js"
    },
    "./release/native/pending-update": {
      "types": "./dist/release/native/pending-update.d.ts",
      "import": "./dist/release/native/pending-update.js"
    },
    "./next/release": {
      "types": "./dist/handlers/next-release.d.ts",
      "import": "./dist/handlers/next-release.js"
    },
    "./cli": {
      "types": "./dist/cli/attach.d.ts",
      "import": "./dist/cli/attach.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./insert": {
      "types": "./dist/insert.d.ts",
      "import": "./dist/insert.js"
    }
  },
  "bin": {
    "bq-flags": "./scripts/bq-flags",
    "bq-release": "./scripts/bq-release"
  },
  "files": [
    "dist",
    "sql",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm test",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "BQ_INTEGRATION=1 vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run examples/cli-smoke/send-events.ts",
    "smoke:query": "bun run examples/cli-smoke/query.ts",
    "smoke:cli-error": "bun run examples/cli-smoke/cli-error.ts",
    "smoke:pino": "bun run examples/cli-smoke/pino-test.ts",
    "smoke:flags": "bun run examples/cli-smoke/edge-config-smoke.ts",
    "smoke:flags-targeting": "bun run examples/cli-smoke/edge-config-targeting-smoke.ts",
    "smoke:feedback": "bun run examples/cli-smoke/feedback-smoke.ts",
    "sync-skills": "./scripts/sync-skills.sh",
    "release": "./scripts/release.sh"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@vercel/edge-config": ">=1",
    "@vercel/functions": ">=2",
    "expo-constants": "*",
    "expo-updates": "*",
    "expo-web-browser": "*",
    "next": ">=14",
    "pino": ">=8",
    "react": ">=18",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@vercel/functions": {
      "optional": true
    },
    "@vercel/edge-config": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "@vercel/edge-config": "^1.4.0",
    "@vercel/functions": "^2.0.0",
    "expo-constants": "^55.0.15",
    "expo-updates": "^55.0.21",
    "expo-web-browser": "^55.0.14",
    "pino": "^9.5.0",
    "react": "^19",
    "react-native": "^0.83",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "analytics",
    "bigquery",
    "posthog-alternative",
    "segment-alternative",
    "vercel",
    "telemetry",
    "events"
  ],
  "engines": {
    "node": ">=20"
  }
}
