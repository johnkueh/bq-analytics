{
  "name": "bq-analytics",
  "version": "0.4.0",
  "description": "Tiny analytics SDK that sends events directly to BigQuery. PostHog/Segment-shaped API, ~$0/month at indie scale, queryable with bq CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnkueh/bq-analytics.git"
  },
  "homepage": "https://github.com/johnkueh/bq-analytics",
  "bugs": {
    "url": "https://github.com/johnkueh/bq-analytics/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.rn.d.ts",
        "import": "./dist/index.rn.js"
      },
      "browser": {
        "types": "./dist/index.rn.d.ts",
        "import": "./dist/index.rn.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "./browser": {
      "types": "./dist/transports/browser.d.ts",
      "import": "./dist/transports/browser.js"
    },
    "./react-native": {
      "types": "./dist/transports/react-native.d.ts",
      "import": "./dist/transports/react-native.js"
    },
    "./next": {
      "types": "./dist/handlers/next.d.ts",
      "import": "./dist/handlers/next.js"
    },
    "./next/flags": {
      "types": "./dist/handlers/next-flags.d.ts",
      "import": "./dist/handlers/next-flags.js"
    },
    "./hono": {
      "types": "./dist/handlers/hono.d.ts",
      "import": "./dist/handlers/hono.js"
    },
    "./pino": {
      "types": "./dist/transports/pino.d.ts",
      "import": "./dist/transports/pino.js"
    },
    "./edge-config": {
      "types": "./dist/flag-sources/edge-config.d.ts",
      "import": "./dist/flag-sources/edge-config.js"
    },
    "./cli": {
      "types": "./dist/cli/attach.d.ts",
      "import": "./dist/cli/attach.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./insert": {
      "types": "./dist/insert.d.ts",
      "import": "./dist/insert.js"
    }
  },
  "bin": {
    "bq-flags": "./scripts/bq-flags"
  },
  "files": [
    "dist",
    "sql",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm test",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "BQ_INTEGRATION=1 vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx examples/cli-smoke/send-events.ts",
    "smoke:query": "tsx examples/cli-smoke/query.ts",
    "smoke:cli-error": "tsx examples/cli-smoke/cli-error.ts",
    "smoke:pino": "tsx examples/cli-smoke/pino-test.ts",
    "smoke:flags": "tsx examples/cli-smoke/edge-config-smoke.ts",
    "smoke:flags-targeting": "tsx examples/cli-smoke/edge-config-targeting-smoke.ts",
    "smoke:feedback": "tsx examples/cli-smoke/feedback-smoke.ts",
    "sync-skills": "./scripts/sync-skills.sh",
    "release": "./scripts/release.sh"
  },
  "dependencies": {},
  "peerDependencies": {
    "next": ">=14",
    "pino": ">=8",
    "@vercel/functions": ">=2",
    "@vercel/edge-config": ">=1"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "@vercel/functions": {
      "optional": true
    },
    "@vercel/edge-config": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/edge-config": "^1.4.0",
    "@vercel/functions": "^2.0.0",
    "pino": "^9.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "analytics",
    "bigquery",
    "posthog-alternative",
    "segment-alternative",
    "vercel",
    "telemetry",
    "events"
  ],
  "engines": {
    "node": ">=20"
  }
}
